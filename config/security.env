# Production source policy.
REQUIRE_PINNED_SHA256=1
REQUIRE_UPSTREAM_SIGNATURE=1

# Set to the full approved upstream OpenSSL release-signing key fingerprint.
# Never accept a key solely because it was downloaded next to the source.
OPENSSL_UPSTREAM_GPG_FINGERPRINT="REPLACE_WITH_APPROVED_FULL_FINGERPRINT"

# Dedicated keyring containing only approved upstream public signing keys.
OPENSSL_UPSTREAM_GNUPGHOME="${OPENSSL_UPSTREAM_GNUPGHOME:-$PWD/keys/upstream-gnupg}"

# RPM signing identity. Prefer full fingerprint.
RPM_GPG_FINGERPRINT="${RPM_GPG_FINGERPRINT:-}"

# Production releases require signed RPMs unless explicitly doing dev-release.
REQUIRE_RPM_SIGNATURE=1
