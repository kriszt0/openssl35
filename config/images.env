# PRODUCTION: mirror and pin these by immutable digest.
# Example:
# BUILD_IMAGE=registry.company.example/oraclelinux:7@sha256:<approved-digest>
BUILD_IMAGE="${BUILD_IMAGE:-oraclelinux:7}"
TEST_IMAGE="${TEST_IMAGE:-oraclelinux:7}"

# Set to 1 only after using immutable @sha256 image references.
REQUIRE_PINNED_CONTAINER_DIGEST="${REQUIRE_PINNED_CONTAINER_DIGEST:-0}"
