# Egyetlen igazságforrás a csomaghoz. Bash-sel source-oljuk, ne legyen benne szóköz az értékekben.
NAME=openssl35
VERSION=3.5.9
RELEASE=1
PREFIX=/opt/openssl35
TARBALL=openssl-3.5.9.tar.gz
SOURCE_URL=https://github.com/openssl/openssl/releases/download/openssl-3.5.9/openssl-3.5.9.tar.gz
# KÖTELEZŐ: a hivatalos kiadás SHA256-ja. Amíg ez a placeholder, a pipeline ELBUKIK (fail-closed).
# Beszerzés: openssl.org/source vagy a GitHub release .sha256 fájlja, és vesd össze a .asc aláírással.
SHA256=REPLACE_WITH_VERIFIED_SHA256
BINARY=/opt/openssl35/bin/openssl
